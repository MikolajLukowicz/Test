<UserControl x:Class="SystemAukcyjny.Wpf.Views.MyAuctionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemAukcyjny.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>
    <TabControl BorderThickness="0,1,0,0">
        <TabItem Header="Moje Wystawione">
            <ListView ItemsSource="{Binding MyAuctions}" BorderThickness="0" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10" Padding="15" CornerRadius="5" Background="#FCFCFC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Tytul}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#FF5A00" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CenaWywolawcza, StringFormat='Cena wyw.: {0:C}'}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Zakończ" Command="{Binding DataContext.EndAuctionCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="0,0,10,0" Padding="10,5"/>
                                    <Button Content="Usuń" Command="{Binding DataContext.DeleteAuctionCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Padding="10,5" Background="#CC0000" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
        <TabItem Header="Licytowane">
            <ListView ItemsSource="{Binding BiddedAuctions}" BorderThickness="0" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10" Padding="15" CornerRadius="5" Background="#FCFCFC">
                            <StackPanel>
                                <TextBlock Text="{Binding Tytul}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Status}" Foreground="#FF5A00" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DataZakonczenia, StringFormat='Kończy się: {0:g}'}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
        <TabItem Header="Wygrane">
            <ListView ItemsSource="{Binding WonAuctions}" BorderThickness="0" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FF5A00" BorderThickness="2" Margin="0,0,0,10" Padding="15" CornerRadius="5" Background="White">
                            <StackPanel>
                                <TextBlock Text="{Binding Auction.Tytul}" FontWeight="Bold" FontSize="18" Foreground="#333"/>
                                <TextBlock Text="GRATULACJE! Wygałeś tę aukcję." Foreground="#27AE60" FontWeight="Bold" Margin="0,5"/>
                                <TextBlock Text="{Binding WinningAmount, StringFormat='Kwota wygranej: {0:C}'}" FontWeight="ExtraBold" FontSize="16" Foreground="#FF5A00"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
    </TabControl>
</UserControl>
