<UserControl x:Class="SystemAukcyjny.Wpf.Views.MyAuctionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemAukcyjny.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="Moje Wystawione">
            <ListView ItemsSource="{Binding MyAuctions}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Tytul}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status}"/>
                                <TextBlock Text="{Binding CenaWywolawcza, StringFormat='Cena wyw.: {0:C}'}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Button Content="Zakończ" Command="{Binding DataContext.EndAuctionCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="0,0,10,0"/>
                                    <Button Content="Usuń" Command="{Binding DataContext.DeleteAuctionCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
        <TabItem Header="Licytowane">
            <ListView ItemsSource="{Binding BiddedAuctions}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Tytul}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status}"/>
                                <TextBlock Text="{Binding DataZakonczenia, StringFormat='Kończy się: {0:g}'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
        <TabItem Header="Wygrane">
            <ListView ItemsSource="{Binding WonAuctions}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Auction.Tytul}" FontWeight="Bold"/>
                                <TextBlock Text="GRATULACJE! Wygałeś tę aukcję." Foreground="Green"/>
                                <TextBlock Text="{Binding WinningAmount, StringFormat='Kwota wygranej: {0:C}'}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </TabItem>
    </TabControl>
</UserControl>
